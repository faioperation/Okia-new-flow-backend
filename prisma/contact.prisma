model Contact {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id")
  payload Json?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  importedOrganizationId String? @map("imported_organization_id") @db.Uuid
  importedOrganization ImportedOrganization? @relation(fields: [importedOrganizationId], references: [id], onDelete: SetNull)

  fullName String @map("full_name") @db.VarChar(255)

  email String? @db.VarChar(255)
  phone String? @db.VarChar(50)

  jobTitle String? @map("job_title") @db.VarChar(255)

  department String? @db.VarChar(150)

  gender String? @db.VarChar(50)

  @@index([organizationId])
  @@index([fullName])
  @@index([email])
  @@map("contacts")
}

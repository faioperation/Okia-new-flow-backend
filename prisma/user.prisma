model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  contactNo String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isBlocked Boolean   @default(true)
  otp       String?
  otpExpiry DateTime?
  role      role    @default(ADMIN)
  cvs       GeneratedCV[]
  importedOrganizations ImportedOrganization[]
  importContacts        ImportContact[]
}

enum role {
  ADMIN
}



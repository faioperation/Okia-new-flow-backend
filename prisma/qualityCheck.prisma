model QualityCheck {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  candidateId  String      @unique @map("candidate_id") @db.Uuid
  cvId         String?     @unique @db.Uuid
  score        Float       @default(0)
  qualityPass  Boolean     @default(false) @map("quality_pass")
  fullResponse Json?       @map("full_response")
  createdAt    DateTime    @default(now()) @map("created_at")
  cv           GeneratedCV? @relation(fields: [cvId], references: [id], onDelete: Cascade)
  candidate    Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("quality_checks")
}

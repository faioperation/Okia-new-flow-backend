<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification Code</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f7;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f7;padding:32px 0;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;background:#ffffff;border:1px solid #eaeaea;border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#333;">
            <tr>
              <td align="center" style="padding:18px 24px;border-bottom:1px solid #f0f0f0;">
                <div style="font-weight:700;font-size:18px;color:#111;letter-spacing:.2px;">🫧 Spartacus Bubble</div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:24px 24px 8px 24px;">
                <div style="font-size:22px;font-weight:700;color:#111;">Verification Code</div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:0 24px 20px 24px;">
                <div style="font-size:14px;line-height:1.6;color:#555;">
                  Hi <span style="font-weight:600;color:#222;"><%= name %></span>, use the code below to verify your account.
                </div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:6px 24px 2px 24px;">
                <div style="font-size:11px;letter-spacing:.24em;text-transform:uppercase;color:#8a8a8a;">One-time password</div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:12px 24px 4px 24px;">
                <div style="text-align:center;">
                  <% otp.toString().split('').forEach(function(digit) { %>
                    <span style="display:inline-block;width:48px;height:56px;line-height:56px;margin:0 6px;border:1px solid #e5e5e5;border-radius:6px;background:#fafafa;font-size:24px;font-weight:700;color:#111;"><%= digit %></span>
                  <% }) %>
                </div>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:8px 24px 22px 24px;">
                <div style="display:inline-block;padding:6px 12px;border:1px solid #d6f0ff;border-radius:20px;color:#0077b6;background:#f1faff;font-size:12px;">Expires in 2 minutes</div>
              </td>
            </tr>
            <tr>
              <td style="padding:0 24px 18px 24px;">
                <div style="background:#fff6e5;border:1px solid #f5d38b;color:#7a5a2a;border-radius:8px;padding:12px 14px;font-size:13px;line-height:1.6;">
                  Never share this code with anyone. Spartacus Bubble will never ask for your OTP via phone, chat, or email.
                </div>
              </td>
            </tr>
            <tr>
              <td style="padding:0 24px 24px 24px;border-top:1px solid #f0f0f0;">
                <div style="font-size:13px;color:#666;line-height:1.7;text-align:center;">
                  Didn't request this code? Ignore this email — your account is safe.
                </div>
              </td>
            </tr>
          </table>
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px;max-width:600px;margin-top:14px;">
            <tr>
              <td align="center" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;color:#8a8a8a;">
                © <%= new Date().getFullYear() %> Spartacus Bubble
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>

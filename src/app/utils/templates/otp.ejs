<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verification Code - Edukai</title>
  </head>
  <body style="margin:0;padding:0;background-color:#f3f6ff;font-family:'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f6ff;padding:40px 0;">
      <tr>
        <td align="center">
          <!-- Main Card -->
          <table role="presentation" width="500" cellpadding="0" cellspacing="0" style="width:500px;max-width:500px;background-color:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 10px 25px rgba(59, 89, 152, 0.1);border:1px solid #e1e7ff;">
            <!-- Header -->
            <tr>
              <td align="center" style="padding:32px 24px;background-color:#3b5998;">
                <div style="color:#ffffff;font-size:24px;font-weight:700;letter-spacing:1px;">EDUKAI</div>
                <div style="color:rgba(255,255,255,0.8);font-size:12px;margin-top:4px;text-transform:uppercase;letter-spacing:2px;">Automation Engine</div>
              </td>
            </tr>
            
            <!-- Content -->
            <tr>
              <td style="padding:40px 32px;">
                <div style="font-size:20px;font-weight:700;color:#1e293b;margin-bottom:12px;text-align:center;">Verify Your Account</div>
                <div style="font-size:15px;line-height:1.6;color:#64748b;text-align:center;margin-bottom:32px;">
                  Hi <span style="font-weight:600;color:#3b5998;"><%= name %></span>,<br>
                  To complete your request, please use the following one-time password (OTP):
                </div>

                <!-- OTP Display -->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:32px;">
                  <tr>
                    <td align="center">
                      <div style="display:inline-block;padding:14px 32px;background-color:#ebf2ff;border:2px solid #3b5998;border-radius:12px;font-size:36px;font-weight:800;color:#3b5998;letter-spacing:8px;text-align:center;font-family:monospace;">
                        <%= otp %>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- Expiry Badge -->
                <div style="text-align:center;margin-bottom:32px;">
                  <span style="display:inline-block;padding:8px 16px;background-color:#fff1f1;color:#e11d48;border-radius:30px;font-size:12px;font-weight:600;border:1px solid #fee2e2;">
                    ⏱️ This code expires in 2 minutes
                  </span>
                </div>

                <!-- Security Note -->
                <div style="background-color:#f8fafc;border-left:4px solid #3b5998;padding:16px;border-radius:8px;margin-bottom:24px;">
                  <div style="font-size:13px;line-height:1.6;color:#475569;">
                    <strong>Security Tip:</strong> Never share this code with anyone. Edukai support will never ask for your password or OTP.
                  </div>
                </div>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td style="padding:24px 32px;background-color:#f1f5f9;border-top:1px solid #e2e8f0;text-align:center;">
                <div style="font-size:12px;color:#94a3b8;line-height:1.5;">
                  If you did not request this code, you can safely ignore this email.<br>
                  © <%= new Date().getFullYear() %> Edukai Engine. All rights reserved.
                </div>
              </td>
            </tr>
          </table>

          <!-- Secondary Footer -->
          <table role="presentation" width="500" cellpadding="0" cellspacing="0" style="width:500px;max-width:500px;margin-top:20px;">
            <tr>
              <td align="center" style="font-size:11px;color:#94a3b8;text-transform:uppercase;letter-spacing:1px;">
                Powered by Edukai Automation Flow
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
